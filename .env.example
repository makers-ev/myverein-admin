# Base URL of the _template_better-auth-backend Hono server. Read client-side
# (NEXT_PUBLIC_*), so it's inlined into the JS bundle at build time -- change
# it and restart `next dev`/rebuild, a running bundle won't pick it up live.
# Must also be added to the backend's own `trustedOrigins` (CORS), otherwise
# every admin action fails as a cross-origin request.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# The consumer-facing site's origin (_template_better-auth-website or
# whatever replaces it) -- this app has no public pages of its own, so an
# admin-triggered verification/password-reset email needs to land the
# target user somewhere they can actually use, not here.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001

# Comma-separated allowlist of hosts this server itself may be reached as.
# Enforced in src/proxy.ts -- if unset, proxy.ts rejects every request, so
# this is required, not optional, despite having no NEXT_PUBLIC_ prefix.
ALLOWED_HOSTS=localhost:3002

# --- Branding (all optional, see src/config/site.ts for defaults) ---
# Everything below is what you change when reusing this template for a new
# project -- no component hardcodes these, they all read from site.ts, which
# reads from here.
NEXT_PUBLIC_APP_NAME=Admin
NEXT_PUBLIC_LOGO_SRC=/logo.svg
NEXT_PUBLIC_APP_TAGLINE=User & access management
NEXT_PUBLIC_LOGIN_TITLE=Sign in
NEXT_PUBLIC_LOGIN_SUBTITLE=Admin access only.
